# Rename this file to .env and fill in your keys

# Groq key -> used for the chat LLM (llama-3.3-70b-versatile)
# get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# Google key -> used for Gemini embeddings (RAG on uploaded documents)
# get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxx

# Tavily key -> used for the Research Agent (web search)
# get a free key at https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxx

# Comma separated list of origins allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173
